# Copy to server/.env and fill in. .env is gitignored — never commit a real key.

PORT=3001

# "mock" (default) or "gemini". Tests always run against the mock.
GRADE_PROVIDER=mock

# Only used when GRADE_PROVIDER=mock: valid | malformed | overmax | throws
MOCK_MODE=valid

# Only used when GRADE_PROVIDER=gemini.
GEMINI_API_KEY=
