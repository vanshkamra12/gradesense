# Copy to server/.env and fill in. .env is gitignored — never commit a real key.

PORT=3001

# "mock" (default) or "gemini". Tests always run against the mock.
GRADE_PROVIDER=mock

# Only used when GRADE_PROVIDER=mock: valid | malformed | overmax | throws | badEvidence
MOCK_MODE=valid

# Only used when GRADE_PROVIDER=gemini.
GEMINI_API_KEY=

# Any vision-capable Gemini model. Availability varies by project and tier, so
# this is configurable rather than fixed — check what your key can reach before
# assuming a model works.
GEMINI_MODEL=gemini-3.5-flash

# Normally empty. Points the provider at a stub endpoint for testing.
GEMINI_BASE_URL=
