{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "print:extract": "tsx src/pdf/print.ts",
    "render:pages": "tsx src/pdf/render-cli.ts",
    "print:rubric": "tsx src/grade/rubric-cli.ts",
    "print:prompt": "tsx src/grade/prompt-cli.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
